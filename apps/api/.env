[Environment]
PRODUCTION=true
DEBUG=false

[Clerk]
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

[Server]
PORT=3002

[Database]
DB_PORT=3306
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=
DB_PREFIX=sc_

# Used for mirroring spotify playlists
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

[Search Engine]
SEARCH_ENGINE_MODULE=meilisearch # Can be set to 'meilisearch' or 'database'
# When set to 'meilisearch', you need to configure the following variables:
SEARCH_ENGINE_HOST=127.0.0.1
SEARCH_ENGINE_PORT=7700
SEARCH_ENGINE_KEY=
