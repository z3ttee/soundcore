{
  "name": "@soundcore/api",
  "version": "0.0.1",
  "description": "Soundcore API service written using NestJS",
  "author": "z3ttee",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "nest start",
    "dev": "nest start --watch",
    "resetAndStart": "yarn resetAll && yarn dev",
    "resetAll": "yarn resetDb && yarn resetMeili",
    "resetDb": "node ./scripts/resetDevDatabase.js",
    "resetMeili": "node ./scripts/resetDevMeilisearch.js",
    "build:api": "nest build && npm run bundle",
    "ci:build": "nest build && npm run bundle",
    "bundle": "node bundle/bundle-packagejson.js && node bundle/bundle-env.js && node bundle/bundle-info.js",
    "bundle:pm2": "npm run build && node ./bundle/bundle-pm2.js",
    "depcheck": "npx depcheck",
    "updatedeps": "npx npm-check-updates"
  },
  "dependencies": {
    "@clerk/backend": "^1.33.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "2.2.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^1.3.0",
    "@nestjs/jwt": "^9.0.0",
    "@nestjs/mapped-types": "^1.1.0",
    "@nestjs/microservices": "^9.0.11",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@repo/bootstrap": "*",
    "@repo/queue": "*",
    "@repo/pipelines": "*",
    "@repo/meilisearch": "*",
    "@repo/nestjs": "*",
    "@repo/utilities": "*",
    "jsonwebtoken": "^9.0.2",
    "axios": "^1.8.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe": "^1.1.2",
    "ffprobe-static": "^3.1.0",
    "glob": "^11.0.1",
    "meilisearch": "^0.49.0",
    "mysql2": "^3.14.0",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "node-id3": "^0.2.8",
    "node-vibrant": "^4.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-filename": "^1.6.3",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "sqlstring": "^2.3.3",
    "typeorm": "^0.3.21",
    "workerpool": "^9.2.0",
    "ytdl-core": "^4.11.5",
    "ytpl": "^2.3.0",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@repo/config-typescript": "*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bull": "^4.10.4",
    "@types/cron": "^2.4.3",
    "@types/express": "^5.0.1",
    "@types/ffmpeg-static": "^3.0.3",
    "@types/ffprobe": "^1.1.8",
    "@types/glob": "^8.1.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.14",
    "@types/sharp": "^0.32.0",
    "@types/sqlstring": "^2.3.2",
    "dotenv": "^16.4.7",
    "eslint": "^8.21.0",
    "eslint-config-nestjs": "*",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "rimraf": "^6.0.1"
  }
